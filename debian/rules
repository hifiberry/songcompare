#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all noautodbgsym

# Cargo must not write outside the build tree: the sbuild chroot has no home
# directory worth persisting, and a shared ~/.cargo would leak between builds.
export CARGO_HOME = $(CURDIR)/debian/cargo
export CARGO_INCREMENTAL = 0

# dh has no cargo build system, so every step below is explicit.
%:
	dh $@

override_dh_auto_clean:
	rm -rf target $(CARGO_HOME)

override_dh_auto_build:
	cargo build --release --locked

override_dh_auto_test:
	cargo test --release --locked

override_dh_auto_install:
	install -D -m 0755 target/release/songcompare \
		debian/hifiberry-songcompare/usr/bin/songcompare
